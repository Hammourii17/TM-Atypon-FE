// © scalp-confluence-strategy
//@version=5
strategy("Scalp Confluence: Accum/POC + Sessions + Fib (auto SL)", overlay=true,
     initial_capital=10000, currency=currency.USD,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ============================================================
// HOW IT WORKS
// 1) Three engines look for a trigger:
//    A. Accumulation range -> breakout -> pullback to POC -> continuation
//    B. Sessions: Asia range -> London sweep/breakout -> NY continuation
//    C. Fibonacci: pullback into the 0.5-0.618 golden pocket of the last
//       swing leg + rejection candle
// 2) Each trigger gets a confluence score 1-3 (how many engines agree
//    within the last few bars; London bias + golden pocket touch count too).
// 3) A trade is TAKEN only if:
//    - last CLOSED 4H candle agrees (above EMA for buys, below for sells) - mandatory
//    - confluence >= your minimum
//    - no trade already open + cooldown passed
//    A wide stop NEVER skips a trade: the signal is shown with its
//    suitable stop, flagged "wide SL", and (in risk sizing) gets a
//    smaller position so the $ risk stays the same.
// 4) Stop-loss (Auto mode, default) is sized to the market, not a fixed $:
//    refATR = max(ATR, 100-bar average ATR); Magic stop = k x refATR,
//    k = 2.5 on <=1h rising to 3.0 on 4h (wider on higher timeframes).
//    TP1/TP2/TP3 = 1R/2R/3R of that stop. "$ move"/"Pips" modes still work.
// 5) Exits: TP1 / TP2 / TP3 (1/3 each). SL -> entry after TP1, SL -> TP1 after TP2.
// Works on 15m, 1h and 4h. Use the Strategy Tester to backtest on XAUUSD.
// ============================================================

// ============================================================
// INPUTS
// ============================================================
grpEng = "1) Signal Engines"
useAccumEngine   = input.bool(true, "A: Accumulation -> POC pullback -> continuation", group=grpEng)
useSessionEngine = input.bool(true, "B: Sessions (Asia range -> London -> NY)", group=grpEng)
useFibEngine     = input.bool(true, "C: Fibonacci golden pocket", group=grpEng)
minConfluence    = input.int(1, "Min confluence (1 = any, 2 = stricter, 3 = all agree)", minval=1, maxval=3, group=grpEng)
confWindow       = input.int(6, "Confluence look-back window (bars)", minval=1, group=grpEng)

grpRisk = "2) Targets & Risk"
AUTO_MODE     = "Auto (ATR, adapts to timeframe)"
targetMode    = input.string(AUTO_MODE, "Unit for all distances", options=[AUTO_MODE, "Price ($ move)", "Pips"], group=grpRisk, tooltip="Auto: SL sized by volatility, TPs at 1R/2R/3R. $/Pips: the fixed distances below.")
tp1Val        = input.float(10, "TP1 (closes 1/3) - $/Pips mode", minval=0.01, group=grpRisk)
tp2Val        = input.float(20, "TP2 (closes 1/3) - $/Pips mode", minval=0.01, group=grpRisk)
tp3Val        = input.float(30, "TP3 (closes the rest) - $/Pips mode", minval=0.01, group=grpRisk)
minSLVal      = input.float(5, "Min SL distance - $/Pips mode", minval=0.01, group=grpRisk)
maxSLVal      = input.float(15, "Wide SL warning above - $/Pips mode (trade is still taken)", minval=0.01, group=grpRisk)
sizeMode      = input.string("Risk $ per trade", "Position sizing", options=["Risk $ per trade", "Fixed"], group=grpRisk, tooltip="Risk $: wider stop = smaller size, so every trade risks the same dollars.")
riskUSD       = input.float(100, "Risk per trade ($) - risk sizing", minval=1, group=grpRisk)
contracts     = input.int(3, "Position size - fixed sizing (min 3, split across TPs)", minval=3, group=grpRisk)
useBreakeven  = input.bool(true, "Move SL to entry after TP1", group=grpRisk)
useLockTP1    = input.bool(true, "Move SL to TP1 after TP2", group=grpRisk)
tradeCooldown = input.int(4, "Bars to wait between trades", minval=0, group=grpRisk)
customPipSize = input.float(0.0, "Pip size override (Pips mode only, 0 = auto)", minval=0.0, step=0.00001, group=grpRisk)

grpSL = "3) Stop-loss"
slMethod      = input.string("Magic (volatility)", "Stop method (Auto mode)", options=["Magic (volatility)", "Structure (swing + ATR)", "Wider of both"], group=grpSL, tooltip="Magic won the backtest; Structure is the original swing/Fib stop; Wider of both uses whichever is further away.")
magicK        = input.float(0.0, "Magic multiplier (0 = auto: 2.5 on <=1h, 3.0 on 4h)", minval=0.0, step=0.1, group=grpSL)
tpR1          = input.float(1.0, "TP1 (R) - Auto mode", minval=0.1, step=0.1, group=grpSL)
tpR2          = input.float(2.0, "TP2 (R) - Auto mode", minval=0.1, step=0.1, group=grpSL)
tpR3          = input.float(3.0, "TP3 (R) - Auto mode", minval=0.1, step=0.1, group=grpSL)
swingLen      = input.int(5, "Swing lookback (bars each side)", minval=2, group=grpSL)
atrLen        = input.int(14, "ATR length", minval=1, group=grpSL)
atrMult       = input.float(0.5, "ATR buffer beyond swing", minval=0.0, step=0.1, group=grpSL)
entryBandMult = input.float(0.15, "Entry zone width (x ATR each side)", minval=0.01, step=0.01, group=grpSL)

grp4h = "4) 4H Trend Filter (always on)"
tf4h   = input.timeframe("240", "Higher timeframe", group=grp4h)
emaLen = input.int(50, "EMA length", minval=5, group=grp4h)

grpA = "Engine A: Accumulation / POC"
rangeLen      = input.int(20, "Range lookback (bars)", minval=5, group=grpA)
rangeMaxPct   = input.float(2.0, "Max range width (% of price)", minval=0.05, step=0.05, group=grpA)
vpLen         = input.int(50, "Volume profile lookback (bars)", minval=10, group=grpA)
vpBins        = input.int(24, "Volume profile bins", minval=8, maxval=100, group=grpA)
pocTolPct     = input.float(0.10, "POC pullback tolerance (% of price)", minval=0.01, step=0.01, group=grpA)
volMultiplier = input.float(1.1, "Breakout volume > avg volume x", minval=1.0, step=0.1, group=grpA)
volAvgLen     = input.int(20, "Volume average length", minval=5, group=grpA)
setupExpiry   = input.int(30, "Setup expires after (bars)", minval=5, group=grpA)

grpB = "Engine B: Sessions"
sessionTz      = input.string("America/New_York", "Session timezone", group=grpB)
asiaSession    = input.session("1900-0300", "Asia", group=grpB)
londonSession  = input.session("0300-1200", "London", group=grpB)
nySession      = input.session("0800-1700", "New York", group=grpB)
enableSweep    = input.bool(true, "London sweep of Asia high/low (fade it)", group=grpB)
enableBreakout = input.bool(true, "London clean breakout of Asia range", group=grpB)
enableNY       = input.bool(true, "NY breaks London high/low (continuation)", group=grpB)
nyNeedsBias    = input.bool(true, "NY only trades in London's direction", group=grpB)

grpC = "Engine C: Fibonacci"
fibMinLegVal = input.float(15, "Min swing leg size (same unit as TPs)", minval=0.01, group=grpC)
gpShallow    = input.float(0.5, "Golden pocket start", minval=0.1, maxval=0.9, step=0.01, group=grpC)
gpDeep       = input.float(0.618, "Golden pocket end", minval=0.1, maxval=0.95, step=0.01, group=grpC)
fibInvalid   = input.float(0.786, "Invalidation level", minval=0.5, maxval=1.0, step=0.01, group=grpC)

grpD = "Display"
showSignals   = input.bool(true, "BUY/SELL labels", group=grpD)
showSkipped   = input.bool(true, "SKIP labels (why a setup was rejected)", group=grpD)
skipCooldown  = input.int(10, "Min bars between SKIP labels", minval=1, group=grpD)
showSessionBg = input.bool(true, "Session background colors", group=grpD)
showAsiaBox   = input.bool(true, "Asia range box", group=grpD)
showLondonBox = input.bool(true, "London range box", group=grpD)
showZone      = input.bool(true, "Accumulation box", group=grpD)
showPOC       = input.bool(true, "POC dots", group=grpD)
showFib       = input.bool(true, "Current Fib golden pocket", group=grpD)
showSwings    = input.bool(true, "Swing high/low triangles", group=grpD)

// ============================================================
// UNITS
// ============================================================
isJPY     = str.contains(syminfo.ticker, "JPY")
pipSize   = customPipSize > 0 ? customPipSize : (isJPY ? 0.01 : syminfo.mintick * 10)
isAuto    = targetMode == AUTO_MODE
unitMult  = targetMode == "Pips" ? pipSize : 1.0
tp1Dist   = tp1Val * unitMult
tp2Dist   = tp2Val * unitMult
tp3Dist   = tp3Val * unitMult
minSL     = minSLVal * unitMult
maxSL     = maxSLVal * unitMult
fibMinLeg = fibMinLegVal * unitMult

// ============================================================
// 4H TREND (last CLOSED 4H candle - no repainting)
// ============================================================
[c4, e4] = request.security(syminfo.tickerid, tf4h, [close[1], ta.ema(close, emaLen)[1]], lookahead=barmerge.lookahead_on)
trend4hUp   = c4 > e4
trend4hDown = c4 < e4

// ============================================================
// SWINGS + ATR  (triangles appear swingLen bars AFTER the real
// high/low - a swing can only be confirmed in hindsight)
// ============================================================
swingHighVal = ta.pivothigh(high, swingLen, swingLen)
swingLowVal  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh    = na
var float lastSwingLow     = na
var int   lastSwingHighBar = na
var int   lastSwingLowBar  = na

if not na(swingHighVal)
    lastSwingHigh    := swingHighVal
    lastSwingHighBar := bar_index - swingLen
if not na(swingLowVal)
    lastSwingLow    := swingLowVal
    lastSwingLowBar := bar_index - swingLen

atrVal    = ta.atr(atrLen)
atrBuffer = atrVal * atrMult

// Reference ATR: a quiet patch right before a signal can't make the stop too tight
refAtr  = math.max(atrVal, nz(ta.sma(atrVal, 100), atrVal))
tfHours = timeframe.in_seconds(timeframe.period) / 3600.0
kAuto   = 2.5 + 0.5 * math.max(0.0, math.min(1.0, math.log(math.max(tfHours, 1.0)) / math.log(2.0) / 2.0))
kMagic  = magicK > 0 ? magicK : kAuto

plotshape(showSwings and not na(swingHighVal), title="Swing High", location=location.abovebar,
     style=shape.triangledown, color=color.new(color.red, 40), size=size.tiny, offset=-swingLen)
plotshape(showSwings and not na(swingLowVal), title="Swing Low", location=location.belowbar,
     style=shape.triangleup, color=color.new(color.lime, 40), size=size.tiny, offset=-swingLen)

// ============================================================
// ENGINE A: ACCUMULATION -> BREAKOUT -> PULLBACK TO POC -> CONTINUATION
// ============================================================
rangeHigh      = ta.highest(high, rangeLen)
rangeLow       = ta.lowest(low, rangeLen)
isAccumulation = (rangeHigh - rangeLow) / close * 100 <= rangeMaxPct

vpHigh  = ta.highest(high, vpLen)
vpLow   = ta.lowest(low, vpLen)
binSize = (vpHigh - vpLow) / vpBins

var float[] binVolume = array.new_float(0)

calcPOC() =>
    array.clear(binVolume)
    for i = 0 to vpBins - 1
        array.push(binVolume, 0.0)
    for i = 0 to vpLen - 1
        barHigh = high[i]
        barLow  = low[i]
        barVol  = volume[i]
        for b = 0 to vpBins - 1
            binLow  = vpLow + b * binSize
            binHigh = binLow + binSize
            overlap = math.min(barHigh, binHigh) - math.max(barLow, binLow)
            if overlap > 0 and (barHigh - barLow) > 0
                array.set(binVolume, b, array.get(binVolume, b) + barVol * overlap / (barHigh - barLow))
    maxIdx = array.indexof(binVolume, array.max(binVolume))
    vpLow + (maxIdx + 0.5) * binSize

poc = calcPOC()

avgVol       = ta.sma(volume, volAvgLen)
volConfirmed = volume > avgVol * volMultiplier
accBreakUp   = useAccumEngine and isAccumulation[1] and close > rangeHigh[1] and volConfirmed
accBreakDn   = useAccumEngine and isAccumulation[1] and close < rangeLow[1] and volConfirmed

var int   accDir = 0
var float accPOC = na
var int   accBar = 0

if accBreakUp
    accDir := 1
    accPOC := poc
    accBar := bar_index
if accBreakDn
    accDir := -1
    accPOC := poc
    accBar := bar_index
if accDir != 0 and bar_index - accBar > setupExpiry
    accDir := 0

pocTol  = close * pocTolPct / 100
nearPOC = not na(accPOC) and math.abs(close - accPOC) <= pocTol

accumLong  = accDir == 1  and nearPOC[1] and close > close[1] and close > accPOC
accumShort = accDir == -1 and nearPOC[1] and close < close[1] and close < accPOC

if accumLong or accumShort
    accDir := 0

var box accBox = na
if showZone and useAccumEngine and isAccumulation
    if not isAccumulation[1]
        accBox := box.new(bar_index - rangeLen, rangeHigh, bar_index, rangeLow,
             border_color=color.new(color.gray, 30), bgcolor=color.new(color.gray, 90))
    else
        box.set_right(accBox, bar_index)
        box.set_top(accBox, rangeHigh)
        box.set_bottom(accBox, rangeLow)

plot(showPOC and useAccumEngine ? poc : na, "POC", color=color.orange, style=plot.style_circles, linewidth=1)

// ============================================================
// ENGINE B: SESSIONS
// ============================================================
inSession(sess) =>
    not na(time(timeframe.period, sess, sessionTz))

isAsia   = inSession(asiaSession) and useSessionEngine
isLondon = inSession(londonSession) and useSessionEngine
isNY     = inSession(nySession) and useSessionEngine

bgcolor(showSessionBg ? (isNY ? color.new(color.purple, 92) : isLondon ? color.new(color.orange, 92) : isAsia ? color.new(color.blue, 92) : na) : na)

var float asiaHigh    = na
var float asiaLow     = na
var float asiaRefHigh = na
var float asiaRefLow  = na
var float londonHigh  = na
var float londonLow   = na
var float lonRefHigh  = na
var float lonRefLow   = na
var int   londonBias  = 0
var bool  londonUsed  = false
var bool  nyUsed      = false

asiaStart   = isAsia and not isAsia[1]
londonStart = isLondon and not isLondon[1]
nyStart     = isNY and not isNY[1]

// Asia builds the range (new Asia session = new trading day)
if asiaStart
    asiaHigh   := high
    asiaLow    := low
    londonBias := 0
    londonUsed := false
    nyUsed     := false
else if isAsia
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)

// London freezes the final Asia range as its reference
if londonStart
    londonHigh  := high
    londonLow   := low
    asiaRefHigh := asiaHigh
    asiaRefLow  := asiaLow
else if isLondon
    londonHigh := math.max(londonHigh, high)
    londonLow  := math.min(londonLow, low)

// NY freezes the London range at NY open as its reference
if nyStart
    lonRefHigh := londonHigh
    lonRefLow  := londonLow

var box asiaBox = na
if showAsiaBox and isAsia
    if asiaStart
        asiaBox := box.new(bar_index, asiaHigh, bar_index, asiaLow,
             border_color=color.new(color.blue, 20), bgcolor=color.new(color.blue, 88))
    else
        box.set_right(asiaBox, bar_index)
        box.set_top(asiaBox, asiaHigh)
        box.set_bottom(asiaBox, asiaLow)

var box londonBox = na
if showLondonBox and isLondon
    if londonStart
        londonBox := box.new(bar_index, londonHigh, bar_index, londonLow,
             border_color=color.new(color.orange, 20), bgcolor=color.new(color.orange, 90))
    else
        box.set_right(londonBox, bar_index)
        box.set_top(londonBox, londonHigh)
        box.set_bottom(londonBox, londonLow)

// London: sweep (wick through Asia level, close back inside) or clean breakout
sweepHigh = enableSweep and isLondon and not na(asiaRefHigh) and high > asiaRefHigh and close < asiaRefHigh
sweepLow  = enableSweep and isLondon and not na(asiaRefLow) and low < asiaRefLow and close > asiaRefLow
breakUp   = enableBreakout and isLondon and not na(asiaRefHigh) and close > asiaRefHigh and close[1] <= asiaRefHigh
breakDn   = enableBreakout and isLondon and not na(asiaRefLow) and close < asiaRefLow and close[1] >= asiaRefLow

londonLong  = not londonUsed and (sweepLow or breakUp)
londonShort = not londonUsed and not londonLong and (sweepHigh or breakDn)

if londonLong
    londonBias := 1
    londonUsed := true
if londonShort
    londonBias := -1
    londonUsed := true

// NY: break of the London range in London's direction
nyLong  = enableNY and isNY and not nyUsed and (not nyNeedsBias or londonBias == 1) and not na(lonRefHigh) and close > lonRefHigh and close[1] <= lonRefHigh
nyShort = enableNY and isNY and not nyUsed and (not nyNeedsBias or londonBias == -1) and not na(lonRefLow) and close < lonRefLow and close[1] >= lonRefLow

if nyLong or nyShort
    nyUsed := true

sessionLong      = londonLong or nyLong
sessionShort     = londonShort or nyShort
sessionLongName  = londonLong ? (sweepLow ? "London Sweep" : "London Breakout") : "NY Continuation"
sessionShortName = londonShort ? (sweepHigh ? "London Sweep" : "London Breakout") : "NY Continuation"

// ============================================================
// ENGINE C: FIBONACCI GOLDEN POCKET
// ============================================================
haveLeg  = not na(lastSwingHigh) and not na(lastSwingLow) and not na(lastSwingHighBar) and not na(lastSwingLowBar)
legUp    = haveLeg and lastSwingHighBar > lastSwingLowBar
legDn    = haveLeg and lastSwingLowBar > lastSwingHighBar
legRange = haveLeg ? lastSwingHigh - lastSwingLow : na
validLeg = haveLeg and legRange >= fibMinLeg
legId    = legUp ? lastSwingHighBar : lastSwingLowBar

// up-leg (buy) levels, measured down from the swing high
gpTopL = lastSwingHigh - legRange * gpShallow
gpBotL = lastSwingHigh - legRange * gpDeep
invL   = lastSwingHigh - legRange * fibInvalid
// down-leg (sell) levels, measured up from the swing low
gpBotS = lastSwingLow + legRange * gpShallow
gpTopS = lastSwingLow + legRange * gpDeep
invS   = lastSwingLow + legRange * fibInvalid

lowRecent2  = math.min(low, low[1])
highRecent2 = math.max(high, high[1])

var int fibUsedLeg = -1

fibLong  = useFibEngine and validLeg and legUp and legId != fibUsedLeg and lowRecent2 <= gpTopL and lowRecent2 > invL and close > gpTopL and close > open
fibShort = useFibEngine and validLeg and legDn and legId != fibUsedLeg and highRecent2 >= gpBotS and highRecent2 < invS and close < gpBotS and close < open

if fibLong or fibShort
    fibUsedLeg := legId

var box   gpBox   = na
var label gpLabel = na
if showFib and useFibEngine and barstate.islast
    box.delete(gpBox)
    label.delete(gpLabel)
    if validLeg
        gpTop = legUp ? gpTopL : gpTopS
        gpBot = legUp ? gpBotL : gpBotS
        gpBox := box.new(legId, gpTop, bar_index + 8, gpBot,
             border_color=color.new(color.yellow, 30), bgcolor=color.new(color.yellow, 88))
        gpLabel := label.new(bar_index + 8, gpTop, "Fib " + str.tostring(gpShallow) + "-" + str.tostring(gpDeep) + (legUp ? " buy zone" : " sell zone"),
             style=label.style_label_left, color=color.new(color.yellow, 30), textcolor=color.black, size=size.small)

// ============================================================
// CONFLUENCE SCORE (1-3)
// ============================================================
recentLow  = ta.lowest(low, confWindow)
recentHigh = ta.highest(high, confWindow)

barsAccL = nz(ta.barssince(accumLong), 999)
barsAccS = nz(ta.barssince(accumShort), 999)
barsSesL = nz(ta.barssince(sessionLong), 999)
barsSesS = nz(ta.barssince(sessionShort), 999)
barsFibL = nz(ta.barssince(fibLong), 999)
barsFibS = nz(ta.barssince(fibShort), 999)

fibConfLong  = useFibEngine and validLeg and legUp and recentLow <= gpTopL and recentLow > invL
fibConfShort = useFibEngine and validLeg and legDn and recentHigh >= gpBotS and recentHigh < invS

confA_L = barsAccL <= confWindow
confB_L = barsSesL <= confWindow or (useSessionEngine and londonBias == 1)
confC_L = barsFibL <= confWindow or fibConfLong
confA_S = barsAccS <= confWindow
confB_S = barsSesS <= confWindow or (useSessionEngine and londonBias == -1)
confC_S = barsFibS <= confWindow or fibConfShort

scoreL = (confA_L ? 1 : 0) + (confB_L ? 1 : 0) + (confC_L ? 1 : 0)
scoreS = (confA_S ? 1 : 0) + (confB_S ? 1 : 0) + (confC_S ? 1 : 0)

// ============================================================
// TRIGGERS + STOPS
// ============================================================
longTrig  = accumLong or sessionLong or fibLong
shortTrig = accumShort or sessionShort or fibShort
longName  = accumLong ? "Accum + POC" : sessionLong ? sessionLongName : "Fib Pocket"
shortName = accumShort ? "Accum + POC" : sessionShort ? sessionShortName : "Fib Pocket"

// Structural stop (original logic)
float slL = fibLong ? invL - atrBuffer : lastSwingLow - atrBuffer
if na(slL) or slL >= close
    slL := close - atrVal * 1.5
float slS = fibShort ? invS + atrBuffer : lastSwingHigh + atrBuffer
if na(slS) or slS <= close
    slS := close + atrVal * 1.5

// Auto mode: pick the stop method, never tighter than 1 refATR of noise
if isAuto
    magicL = close - kMagic * refAtr
    magicS = close + kMagic * refAtr
    slL := slMethod == "Magic (volatility)" ? magicL : slMethod == "Structure (swing + ATR)" ? slL : math.min(slL, magicL)
    slS := slMethod == "Magic (volatility)" ? magicS : slMethod == "Structure (swing + ATR)" ? slS : math.max(slS, magicS)

minStop = isAuto ? refAtr : minSL
if close - slL < minStop
    slL := close - minStop
if slS - close < minStop
    slS := close + minStop

// Wide stops are flagged, never skipped
wideStop = isAuto ? 4.0 * refAtr : maxSL
slWideL  = close - slL > wideStop
slWideS  = slS - close > wideStop

// ============================================================
// FINAL DECISION
// ============================================================
var int lastTradeBar = -100000
flat   = strategy.position_size == 0
cooled = bar_index - lastTradeBar > tradeCooldown

finalLong  = longTrig and flat and cooled and trend4hUp and scoreL >= minConfluence
finalShort = shortTrig and flat and cooled and trend4hDown and scoreS >= minConfluence and not finalLong

// SKIP labels: a setup appeared but was rejected (shows the reason)
skipL = longTrig and flat and cooled and not finalLong
skipS = shortTrig and flat and cooled and not finalShort and not finalLong and not skipL

var int lastSkipBar = -100000
if showSkipped and (skipL or skipS) and bar_index - lastSkipBar >= skipCooldown
    lastSkipBar := bar_index
    reason = skipL ? (not trend4hUp ? "4H ✗" : "Low conf") : (not trend4hDown ? "4H ✗" : "Low conf")
    label.new(bar_index, skipL ? low : high, "SKIP " + (skipL ? "buy" : "sell") + ": " + reason,
         yloc=skipL ? yloc.belowbar : yloc.abovebar, style=skipL ? label.style_label_up : label.style_label_down,
         color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)

// ============================================================
// TRADE STATE + DRAWINGS
// ============================================================
var int   tDir   = 0
var float tEntry = na
var float tSL    = na
var float tTP1   = na
var float tTP2   = na
var float tTP3   = na
var int   tQty   = 3
var bool  tHit1  = false
var bool  tHit2  = false

var line  lnSL    = na
var line  lnTP1   = na
var line  lnTP2   = na
var line  lnTP3   = na
var label lbSL    = na
var label lbTP1   = na
var label lbTP2   = na
var label lbTP3   = na
var label lbEntry = na

if strategy.position_size == 0 and strategy.position_size[1] != 0
    tDir := 0

if finalLong or finalShort
    tDir   := finalLong ? 1 : -1
    tEntry := close
    tSL    := finalLong ? slL : slS
    risk    = math.abs(close - tSL)
    tTP1   := close + tDir * (isAuto ? tpR1 * risk : tp1Dist)
    tTP2   := close + tDir * (isAuto ? tpR2 * risk : tp2Dist)
    tTP3   := close + tDir * (isAuto ? tpR3 * risk : tp3Dist)
    tHit1  := false
    tHit2  := false
    lastTradeBar := bar_index
    // Risk sizing: wider stop -> smaller size (min 3 so it splits across the TPs)
    tQty   := sizeMode == "Fixed" ? contracts : math.max(3, int(math.floor(riskUSD / (risk * syminfo.pointvalue))))

    if finalLong
        strategy.entry("Scalp", strategy.long, qty=tQty)
    else
        strategy.entry("Scalp", strategy.short, qty=tQty)

    zoneLo = close - atrVal * entryBandMult
    zoneHi = close + atrVal * entryBandMult
    score  = finalLong ? scoreL : scoreS
    stars  = score >= 3 ? "★★★" : score == 2 ? "★★☆" : "★☆☆"
    sigTxt = (finalLong ? "BUY " : "SELL ") + stars + "\n" + (finalLong ? longName : shortName) +
         "\nZone " + str.tostring(zoneLo, format.mintick) + " - " + str.tostring(zoneHi, format.mintick) +
         "\nSL " + str.tostring(risk, format.mintick) + " away · size " + str.tostring(tQty) +
         ((finalLong ? slWideL : slWideS) ? "\n⚠ wide SL · size down" : "")

    if showSignals
        label.new(bar_index, finalLong ? low : high, sigTxt,
             yloc=finalLong ? yloc.belowbar : yloc.abovebar, style=finalLong ? label.style_label_up : label.style_label_down,
             color=finalLong ? color.green : color.red, textcolor=color.white, size=size.small)

    box.new(bar_index - 2, zoneHi, bar_index + 2, zoneLo, border_color=color.new(color.yellow, 20), bgcolor=color.new(color.yellow, 80))

    lnSL  := line.new(bar_index, tSL, bar_index + 1, tSL, color=color.red, style=line.style_dashed, width=2)
    lnTP1 := line.new(bar_index, tTP1, bar_index + 1, tTP1, color=color.new(color.green, 50), style=line.style_dashed)
    lnTP2 := line.new(bar_index, tTP2, bar_index + 1, tTP2, color=color.new(color.green, 25), style=line.style_dashed)
    lnTP3 := line.new(bar_index, tTP3, bar_index + 1, tTP3, color=color.green, style=line.style_dashed, width=2)

    lbEntry := label.new(bar_index + 1, tEntry, "ENTRY " + str.tostring(tEntry, format.mintick),
         style=label.style_label_left, color=color.blue, textcolor=color.white, size=size.small)
    lbSL  := label.new(bar_index + 1, tSL, "SL " + str.tostring(tSL, format.mintick),
         style=label.style_label_left, color=color.red, textcolor=color.white, size=size.small)
    lbTP1 := label.new(bar_index + 1, tTP1, "TP1 " + str.tostring(tTP1, format.mintick),
         style=label.style_label_left, color=color.new(color.green, 40), textcolor=color.white, size=size.small)
    lbTP2 := label.new(bar_index + 1, tTP2, "TP2 " + str.tostring(tTP2, format.mintick),
         style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
    lbTP3 := label.new(bar_index + 1, tTP3, "TP3 " + str.tostring(tTP3, format.mintick),
         style=label.style_label_left, color=color.green, textcolor=color.white, size=size.small)

// ============================================================
// EXIT MANAGEMENT
// ============================================================
inTrade = tDir != 0 and (strategy.position_size != 0 or finalLong or finalShort)

if inTrade
    if strategy.position_size != 0
        if not tHit1 and (tDir == 1 ? high >= tTP1 : low <= tTP1)
            tHit1 := true
            label.set_text(lbTP1, "TP1 ✓ " + str.tostring(tTP1, format.mintick))
        if not tHit2 and (tDir == 1 ? high >= tTP2 : low <= tTP2)
            tHit2 := true
            label.set_text(lbTP2, "TP2 ✓ " + str.tostring(tTP2, format.mintick))

    effSL = tHit2 and useLockTP1 ? tTP1 : tHit1 and useBreakeven ? tEntry : tSL
    qPart = math.max(1, math.floor(tQty / 3))

    if not tHit1
        strategy.exit("TP1", from_entry="Scalp", qty=qPart, limit=tTP1, stop=effSL)
    if not tHit2
        strategy.exit("TP2", from_entry="Scalp", qty=qPart, limit=tTP2, stop=effSL)
    strategy.exit("TP3", from_entry="Scalp", qty_percent=100, limit=tTP3, stop=effSL)

    line.set_y1(lnSL, effSL)
    line.set_y2(lnSL, effSL)
    line.set_x2(lnSL, bar_index + 1)
    line.set_x2(lnTP1, bar_index + 1)
    line.set_x2(lnTP2, bar_index + 1)
    line.set_x2(lnTP3, bar_index + 1)
    label.set_y(lbSL, effSL)
    label.set_text(lbSL, "SL " + str.tostring(effSL, format.mintick))
    label.set_x(lbSL, bar_index + 1)
    label.set_x(lbTP1, bar_index + 1)
    label.set_x(lbTP2, bar_index + 1)
    label.set_x(lbTP3, bar_index + 1)
    label.set_x(lbEntry, bar_index + 1)

// ============================================================
// STATUS PANEL
// ============================================================
var label statusLabel = na
if barstate.islast
    label.delete(statusLabel)
    sessNow = isNY ? "New York" : isLondon ? "London" : isAsia ? "Asia" : "Off-session"
    biasTxt = londonBias == 1 ? "Bullish" : londonBias == -1 ? "Bearish" : "None yet"
    legTxt  = validLeg ? (legUp ? "Up leg (look for buys in pocket)" : "Down leg (look for sells in pocket)") : "No valid leg"
    statusLabel := label.new(bar_index + 5, high,
         "4H trend: " + (trend4hUp ? "UP (buys only)" : "DOWN (sells only)") +
         "\nSession: " + sessNow +
         "\nLondon bias: " + biasTxt +
         "\nFib: " + legTxt +
         "\nStop: " + (isAuto ? slMethod + " · k " + str.tostring(kMagic, "#.##") + " · refATR " + str.tostring(refAtr, format.mintick) : targetMode),
         style=label.style_label_left, color=color.new(color.blue, 70), textcolor=color.white, size=size.small)
